# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; this template is committed.
#
# Every outbound call is made by server/swytchcode.ts. Nothing here is ever
# exposed to the browser — the Vite dev server proxies /api to the
# orchestrator, so no credential is bundled into client code.
#
# Any service left blank falls back to seeded local data. The app still runs
# and the UI labels the run as DEGRADED rather than pretending it was live.
# ---------------------------------------------------------------------------

# --- Swytchcode: the mandated execution layer for all external API calls ---
SWYTCHCODE_API_KEY=
SWYTCHCODE_BASE_URL=

# --- Fixed daily publish time (cron, server local time) --------------------
# Default 09:00 every day.
PUBLISH_CRON=0 9 * * *
PUBLISH_LABEL=09:00 daily

# --- Gate thresholds -------------------------------------------------------
# Share of claims that must be corroborated before unattended publishing.
GATE_EVIDENCE_COVERAGE=0.8
# Distinct publishers required to count a claim as corroborated.
GATE_MIN_INDEPENDENT_SOURCES=2
# Sensitivity score at or above which we refuse to publish unattended.
GATE_SENSITIVITY_BLOCK=0.5
# Similarity to an already-published post at or above which it is a repeat.
GATE_NOVELTY_BLOCK=0.86

# --- Orchestrator ----------------------------------------------------------
PORT=8787
